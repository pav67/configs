#!/bin/bash
set -euo pipefail
umask 077
capture_dir="$HOME/Images/Captures"
mkdir -p "$capture_dir"
mode="${1:-all}"
geometry=""
case "$mode" in
    area) geometry=$(slurp -b '#11111bcc' -c '#cba6f7' -w 2) || exit 0 ;;
    all) ;;
    *) exit 2 ;;
esac
capture_file=$(mktemp "$capture_dir/Capture-$(date +%Y-%m-%d_%H-%M-%S)-XXXXXX.png")
trap 'rm -f -- "$capture_file"' ERR
if [[ "$mode" == area ]]; then
    grim -g "$geometry" "$capture_file"
else
    grim "$capture_file"
fi
trap - ERR
if wl-copy --type image/png < "$capture_file"; then
    # Conserver aussi la capture si le service d’historique redémarre.
    cliphist -max-items 2000 store < "$capture_file" || true
    message='Capture enregistrée et copiée'
else
    message='Capture enregistrée — copie impossible'
fi
notify-send -a "Capture d’écran" -i "$capture_file" "$message" "$capture_file" >/dev/null 2>&1 || true
