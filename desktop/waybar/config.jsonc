{
  "layer": "top",
  "position": "top",
  "height": 40,
  "margin-top": 10,
  "margin-left": 14,
  "margin-right": 14,
  "spacing": 6,
  "modules-left": [
    "wlr/taskbar"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "custom/reunion",
    "cpu",
    "memory",
    "network",
    "pulseaudio",
    "tray",
    "custom/session"
  ],
  "clock": {
    "format": "  {:%H:%M  ·  %d/%m}",
    "format-alt": "  {:%A %d %B %Y}",
    "tooltip-format": "{:%A %d %B %Y}"
  },
  "cpu": {
    "format": "  {usage}%",
    "interval": 3,
    "tooltip": true
  },
  "memory": {
    "format": "  {percentage}%",
    "interval": 5,
    "tooltip-format": "Mémoire : {used:0.1f} / {total:0.1f} Gio"
  },
  "network": {
    "format-ethernet": "  Connecté",
    "format-wifi": "  {essid}",
    "format-disconnected": "  Hors ligne",
    "tooltip-format": "{ifname} · {ipaddr}",
    "max-length": 22
  },
  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "  Muet",
    "format-icons": {
      "default": [
        "",
        "",
        ""
      ]
    },
    "on-click": "env GTK_THEME=Adwaita:dark pavucontrol",
    "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "scroll-step": 5
  },
  "tray": {
    "icon-size": 17,
    "spacing": 10
  },
  "custom/session": {
    "format": "",
    "tooltip-format": "Menu de session",
    "menu": "on-click",
    "menu-file": "@HOME@/.config/waybar/session-menu.xml",
    "menu-actions": {
      "logout": "hyprctl dispatch exit",
      "reboot": "systemctl reboot",
      "shutdown": "systemctl poweroff",
      "lock": "hyprlock"
    }
  },
  "wlr/taskbar": {
    "all-outputs": false,
    "format": "{icon} {title:.28}",
    "icon-size": 18,
    "tooltip-format": "{title}",
    "on-click": "activate",
    "markup": false
  },
  "custom/reunion": {
    "exec": "@HOME@/.local/bin/reunion-audio status",
    "return-type": "json",
    "interval": 2,
    "on-click": "@HOME@/.local/bin/reunion-audio toggle",
    "on-click-right": "@HOME@/.local/bin/reunion-audio menu",
    "escape": true
  }
}
